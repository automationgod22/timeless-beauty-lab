---
import Pic from './Pic.astro';
import Icon from './Icon.astro';
import { priceLabel, type Facial } from '../data/content';
interface Props { f: Facial; n?: number; class?: string; sizes?: string; vt?: boolean }
const { f, n, class: cls = '', sizes = '(max-width: 600px) 90vw, (max-width: 980px) 45vw, 30vw', vt = true } = Astro.props;
const includes = f.steps.map((s) => s.name).join(', ');
---
<a class={`fcard zoom ${cls}`} href={`/facials/${f.slug}/`} data-astro-prefetch data-cursor="View">
  <div class="fc-top">
    <span class="label no">{n ? `No. ${String(n).padStart(2, '0')}` : 'Signature facial'}</span>
    <span class="label">{f.minutes}</span>
  </div>
  <Pic name={f.img} alt={f.imgAlt} sizes={sizes} vt={vt ? `facial-${f.slug}` : undefined}>
    {f.flag && <span class="tag">{f.flag}</span>}
    <span class="fc-view" aria-hidden="true">View the ritual <Icon name="arrow" /></span>
  </Pic>
  <h3>{f.name}</h3>
  <p>{f.tagline}</p>
  <ul class="fc-tech" aria-label={`Includes ${includes}`}>
    {f.steps.map((s) => <li title={s.name}><Icon name={s.icon} /></li>)}
  </ul>
  <div class="meta">
    <span class:list={['price', { req: !f.price }]}>{priceLabel(f.price)}</span>
    <span class="go" aria-hidden="true"><Icon name="arrow" /></span>
  </div>
</a>
