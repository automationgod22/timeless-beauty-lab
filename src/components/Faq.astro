---
import Icon from './Icon.astro';
interface Props { items: [string, string][] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map(([q, a]) => (
    <details>
      <summary><span>{q}</span><Icon name="plus" /></summary>
      <div class="ans"><p>{a}</p></div>
    </details>
  ))}
</div>
