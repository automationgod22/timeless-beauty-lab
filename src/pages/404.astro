---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base noOffer title="Page not found | Timeless Beauty Lab" description="This page could not be found." noindex>
  <section class="nf">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 class="d1" data-split="load">This page has slipped away.</h1>
      <div data-reveal class="mt-s"><p class="lede">The link may be old or mistyped. Everything else is just a click away.</p></div>
      <div class="btns" data-reveal>
        <a class="btn btn-primary" href="/" data-magnetic><span>Back to home</span></a>
        <a class="link" href="/facials/"><span>Explore the facials</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>
