---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Pic from '../components/Pic.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import Quotes from '../components/Quotes.astro';
import { SITE } from '../data/site';
import { BOOKABLE, TECH } from '../data/content';
import { breadcrumbs, businessId } from '../data/schema';

const site = Astro.site!;
const crumbs: [string, string][] = [['Home', '/'], ['About', '/about/']];
const aboutPage = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${SITE.owner}`,
  url: new URL('/about/', site).toString(),
  mainEntity: {
    '@type': 'Person',
    name: SITE.owner,
    jobTitle: SITE.ownerTitle,
    worksFor: { '@id': businessId(site) },
    knowsAbout: ['HydroFacial', 'Microcurrent facial', 'RF skin tightening', 'Chemical peels', 'Lymphatic drainage facial massage', 'Buccal massage'],
  },
};
const values = [
  { icon: 'peel', title: 'Non-invasive by design', text: 'No needles and no fillers. Professional devices, peels and skilled hands, chosen for visible results with little or no downtime.' },
  { icon: 'arch', title: 'One client at a time', text: 'A calm, private suite and full attention, from the first question to your aftercare.' },
  { icon: 'rf', title: 'Always learning', text: 'Ongoing training in the latest devices and techniques, brought back to the treatment room for you.' },
];
---
<Base
  title="About Tatiana, Licensed Cosmetologist | Timeless Beauty Lab"
  description="Meet Tatiana, the licensed cosmetologist behind Timeless Beauty Lab in Jersey City, with eight years in advanced facials, peels and facial sculpting."
  og="about"
  jsonLd={[aboutPage, breadcrumbs(site, crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="The founder"
    title={`Meet *${SITE.owner}*`}
    lede={`Licensed cosmetologist, eight years in skin, and the hands behind every treatment at ${SITE.name}.`}
  />

  <section class="sec" aria-labelledby="story-title">
    <div class="wrap split">
      <Pic name="portrait-1" alt={`${SITE.owner}, founder of ${SITE.name}`} class="arch ratio-45" parallax eager sizes="(max-width: 900px) 92vw, 45vw" />
      <div>
        <p class="eyebrow">The story</p>
        <h2 id="story-title" data-split>Results-driven. <em>Never rushed.</em></h2>
        <div class="prose mt-s" data-reveal>
          <p>{SITE.owner} is a licensed cosmetologist with eight years of experience in professional skincare. She opened {SITE.name} to offer something she believes every client deserves: advanced, non-invasive treatments with visible results, in a space that feels calm and personal.</p>
          <p>Every visit starts with your skin, not a script. {SITE.owner} combines professional technology, from HydroFacial and microcurrent to RF tightening and carboxytherapy, with skilled, sculpting hands, and adjusts each step to how your skin looks and feels on the day.</p>
        </div>
        <div class="counts">
          <div><b data-count={SITE.yearsExperience}>{SITE.yearsExperience}</b><span>Years of experience</span></div>
          <div><b data-count={BOOKABLE.length}>{BOOKABLE.length}</b><span>Treatments on the menu</span></div>
          <div><b data-count={TECH.length}>{TECH.length}</b><span>Professional technologies</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tint" aria-labelledby="values-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">What you can expect</p>
          <h2 id="values-title" data-split>Three promises, <em>every visit.</em></h2>
        </div>
      </div>
      <div class="values" data-reveal>
        {values.map((v) => (
          <div>
            <Icon name={v.icon} />
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="learning-title">
    <div class="wrap split rev">
      <Pic name="portrait-2" alt={`${SITE.owner} at the International Beauty Show in New York`} class="round ratio-45" parallax sizes="(max-width: 900px) 92vw, 45vw" />
      <div>
        <p class="eyebrow">Always learning</p>
        <h2 id="learning-title" data-split>From IBS New York <em>back to your treatment.</em></h2>
        <div class="prose mt-s" data-reveal>
          <p>{SITE.owner} keeps up with what is new in professional skincare, from advanced device training to international events like the International Beauty Show in New York.</p>
          <p>Only what works makes it into the treatment room, so every facial on the menu is one she trusts for her own clients.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec tint" aria-labelledby="studio-title">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">The studio</p>
          <h2 id="studio-title" data-split>A private suite <em>in Jersey City.</em></h2>
        </div>
        <div class="side" data-reveal>
          <p class="body-2">Suite 113 at {SITE.address.building}, {SITE.address.street.split(',')[0]}. Quiet, warm and fully private: one client at a time.</p>
          <a class="link" href={SITE.mapsUrl} target="_blank" rel="noopener"><span>Get directions</span><Icon name="arrow" /></a>
        </div>
      </div>
      <div class="trio" data-reveal>
        <Pic name="studio-2" alt="The warmly lit treatment suite" sizes="(max-width: 760px) 92vw, 42vw" />
        <Pic name="studio-1" alt="Treatment room details at Timeless Beauty Lab" sizes="(max-width: 760px) 46vw, 29vw" />
        <Pic name="studio-door" alt="Suite 113 at Phenix Salon Suites" sizes="(max-width: 760px) 46vw, 29vw" />
      </div>
    </div>
  </section>

  <Quotes ids={['coolest-master', 'pampering', 'found-you']} title="Why clients *come back.*" />

  <CtaBand title={`Meet ${SITE.owner} *in person.*`} />
</Base>
