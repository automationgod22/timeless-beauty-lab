---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { FACIALS, PEELS, MASSAGES, priceLabel } from '../data/content';
import { breadcrumbs } from '../data/schema';

const site = Astro.site!;
const crumbs: [string, string][] = [['Home', '/'], ['Prices', '/prices/']];
const sections = [
  {
    id: 'facials', title: 'Signature facials', text: 'Advanced, multi-step facials that combine professional devices and skilled hands.',
    rows: FACIALS.map((f) => ({ id: f.slug, name: f.name, meta: f.minutes, text: f.tagline, price: f.price, href: `/facials/${f.slug}/` })),
  },
  {
    id: 'peels', title: 'Professional peels', text: 'Biorevitalizing and classic peels, chosen for your skin and the season.',
    rows: PEELS.map((p) => ({ id: p.id, name: p.name, meta: p.by, text: p.text, price: p.price, href: '/peels/' })),
  },
  {
    id: 'massage', title: 'Facial massage', text: 'Hands-on sculpting techniques, on their own or as signature pairings.',
    rows: MASSAGES.map((m) => ({ id: m.id, name: m.name, meta: undefined, text: m.text, price: m.price, href: m.href ?? '/facial-massage/' })),
  },
];
---
<Base
  title="Facial Prices in Jersey City | Timeless Beauty Lab"
  description="Starting prices for advanced facials, professional peels and facial massage at Timeless Beauty Lab, Jersey City. Glass Skin Glow Up from $295."
  jsonLd={[breadcrumbs(site, crumbs)]}
>
  <PageHero crumbs={crumbs} eyebrow="Clear pricing" title="Treatment menu *and prices*" lede="Clear starting prices for every treatment. Your final price is confirmed at your consultation, before anything begins.">
    <nav class="chips mt-s" aria-label="Jump to a section">
      {sections.map((s) => <a class="chip-s" href={`#${s.id}`}>{s.title}</a>)}
    </nav>
  </PageHero>

  <section class="sec">
    <div class="wrap">
      {sections.map((s) => (
        <div class="menu-sec" id={s.id}>
          <h2 data-split>{s.title}</h2>
          <p class="body-2">{s.text}</p>
          <div>
            {s.rows.map((r) => (
              <a class="menu-row" href={r.href}>
                <span class="n">{r.name}{r.meta && <small>{r.meta}</small>}</span>
                <span class:list={['p', 'price', { req: !r.price }]}>{priceLabel(r.price)}</span>
                <span class="d">{r.text}</span>
              </a>
            ))}
          </div>
        </div>
      ))}
      <p class="note mt-l">“From” prices are starting prices. Add-ons, programs and combinations are quoted personally. Nothing is charged without your agreement.</p>
      <div class="btns mt-m">
        <a class="btn btn-primary" href="/book/" data-magnetic><span>Book an appointment</span></a>
        <a class="link" href="/skin-quiz/"><span>Find your treatment with the skin quiz</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
